# Used only by `vite --mode campus`; contains no credentials.
VITE_API_BASE_URL=/api/v1
VITE_API_BFF_URL=/api/v1
VITE_API_STREAM_URL=/record-api/api/v1
VITE_SOCKET_IO_BASE_URL=http://127.0.0.1:5173
VITE_SOCKET_BASE_URL=ws://127.0.0.1:5173
VITE_SOCKET_ALTERNATIVE_BASE_URL=ws://127.0.0.1:5173

# Set to true to run the UI on fixture data only (no API/socket traffic leaves the browser).
# Same effect as `npm run dev:preview`. Ignored by production builds.
VITE_UI_PREVIEW=false
