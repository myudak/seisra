# Lindu configuration — copy to .env and edit. Never commit .env.
# Every service reads this one file (compose.yaml: env_file).

# ---- Published ports (everything else stays on the internal network)
WEB_PORT=8080
FDSN_API_PORT=38002
PUBLIC_API_PORT=38007

# ---- Login token signing key (required). Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=

# ---- First admin account (created on first start; change the password after login)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-please
INITIAL_ADMIN_EMAIL=admin@example.org
INITIAL_ADMIN_FULLNAME=Administrator
INITIAL_ADMIN_REGION=Indonesia

# ---- Infrastructure (service names from compose.yaml)
kafka_host=kafka
kafka_port=9092
redis_host=redis
redis_port=6379
database_host=mongodb
database_port=27017
database_name=sispro-tews
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=sispro-tews
MONGO_CONNECT_RETRIES=10
MONGO_CONNECT_RETRY_DELAY=3

# ---- Seismic data
seedlink_url=geofon.gfz-potsdam.de:18000
regional=user_bmkg
regional_player=user_player
STATION_CSV=station_public20.csv
# Waveform archive: a named volume by default; set a host path on a server, e.g. /mnt/archive
ARCHIVE_PATH=archive

# ---- Kafka topics used by the AI pipeline
waveform_topic=waveform_seedlink
arrival_waveform_topic=arrival_waveform
pick_topic=pick
cluster_topic=cluster
arrival_pick_topic=arrival_pick
event_topic=event

# ---- Scale and retention
seedlink_replica_count=2
archive_replica_count=3
p_pick_replicas=2
ARCHIVE_RETENTION_DAYS=90
LOG_RETENTION_DAYS=14
DB_PICKS_RETENTION_DAYS=30

# ---- Optional: SSH bridge used by some controller routes (leave empty if unused)
ssh_host=
ssh_port=22
ssh_username=
ssh_password=
